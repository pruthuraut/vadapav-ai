# bb-harness API Keys & Configuration Template
# Copy this file to .env and fill in your keys: cp .env.example .env

# Execution Mode: host or container
BB_MODE=host

# Passive & OSINT Subdomain Enumeration
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GITHUB_TOKEN=
CHAOS_API_KEY=

# Tech Fingerprinting & Web Intelligence
BUILTWITH_API_KEY=
WHOXY_API_KEY=
FOFA_EMAIL=
FOFA_KEY=
ZOOMEYE_API_KEY=

# Scan Performance
BB_MAX_CONCURRENCY=10
BB_HTTP_TIMEOUT=15
BB_RATE_LIMIT=50
