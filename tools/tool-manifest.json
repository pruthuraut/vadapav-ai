    "cloud_container": {"tools": ["trivy", "kube-bench", "prowler", "scoutsuite"], "safe": false, "gated": true},
    "takeover": {"tools": ["nuclei", "subjack", "subover", "dnsreaper"], "safe": true, "requires_live_probe": true},
